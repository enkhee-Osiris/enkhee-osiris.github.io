---
import "@/styles/reset.css";
import "@/styles/global.css";
import "@/styles/cookie.css";

import { Font } from "astro:assets";

import { SITE_TITLE } from "@/constants";

interface Props {
  title: string;
  description: string;
  image?: string;
}

const fullUrl = new URL(import.meta.env.BASE_URL, Astro.site);

const { title, description, image } = Astro.props;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<script is:inline>
  (function () {
    var theme = localStorage.getItem("theme");

    if (theme === "light" || theme === "dark") {
      document.documentElement.setAttribute("data-theme", theme);
    }
  })();
</script>
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/png" href={new URL("favicon-96x96.png", fullUrl)} sizes="96x96" />
<link rel="icon" type="image/svg+xml" href={new URL("favicon.svg", fullUrl)} />
<link rel="shortcut icon" href={new URL("favicon.ico", fullUrl)} />
<link rel="apple-touch-icon" sizes="180x180" href={new URL("apple-touch-icon.png", fullUrl)} />
<meta name="apple-mobile-web-app-title" content={SITE_TITLE} />
<link rel="sitemap" href={new URL("sitemap-index.xml", fullUrl)} />
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href={new URL("rss.xml", fullUrl)}
/>
<meta name="generator" content={Astro.generator} />

<meta name="google-site-verification" content="EzrQA4W1SfUYUo2iAlbbYoWrNJbqHCXGqImBZkKpKy8" />

<!-- Font preloads - Local fonts -->
<Font cssVariable="--font-pt-serif-pro" preload />
<Font cssVariable="--font-schoolbook-new" preload />

<!-- Canonical URL -->
<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{image && <meta property="og:image" content={new URL(image, Astro.url)} />}
{image && <meta property="og:image:type" content="image/png" />}
{image && <meta property="og:image:width" content="1200" />}
{image && <meta property="og:image:height" content="630" />}

<!-- Twitter -->
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
{image && <meta property="twitter:image" content={new URL(image, Astro.url)} />}
{image && <meta name="twitter:card" content="summary_large_image" />}
