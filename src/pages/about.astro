---
import SocialLinks from "@/components/SocialLinks.astro";
import { AUTHOR, DESCRIPTIONS, EXPERIENCES, FULL_URL, PROJECTS, TITLES } from "@/constants";
import BaseLayout from "@/layouts/BaseLayout.astro";

const ogImageUrl = new URL(`og/about.png`, FULL_URL).href;
---

<BaseLayout pagefindIgnore title={TITLES.about} description={DESCRIPTIONS.about} image={ogImageUrl}>
  <div class="container">
    <section class="section" aria-label="About me">
      <h1 class="name">{AUTHOR}</h1>

      <div class="bio">
        <p>
          I was born and raised in Ulaanbaatar, Mongolia. I enjoy exploring modern technologies,
          continuously learning new things, and building applications that solve real problems.
        </p>
        <p>
          I'm a front-end developer with 9 years of experience building web and mobile applications.
          I primarily work with HTML, CSS, JavaScript, and TypeScript, and enjoy using modern
          frameworks and configuring CI/CD pipelines to improve the development experience.
        </p>
      </div>

      <SocialLinks />
    </section>

    <section class="section" aria-labelledby="experience-heading">
      <h2 class="section-heading" id="experience-heading">Experience</h2>

      <ul class="experience-list" role="list">
        {
          EXPERIENCES.map(exp => (
            <li class="experience-item">
              <div class="exp-icon" aria-hidden="true">
                {exp.icon ? (
                  <Fragment set:html={exp.icon} />
                ) : (
                  <span class="exp-initial">{exp.company.charAt(0)}</span>
                )}
              </div>

              <div class="exp-content">
                <div class="exp-header">
                  <h3 class="exp-company">{exp.company}</h3>
                  <p class="exp-period">
                    <time datetime={exp.start}>{exp.start}</time>
                    {" — "}
                    {exp.end ? <time datetime={exp.end}>{exp.end}</time> : "Present"}
                  </p>
                </div>

                <p class="exp-role">{exp.role}</p>

                {exp.projects.length > 0 && (
                  <ul class="exp-projects" role="list">
                    {exp.projects.map(project => (
                      <li class="exp-project">
                        <p class="exp-project-name">
                          <strong>{project.name}</strong>
                          {" — "}
                          {project.description}
                        </p>
                        <ul class="exp-highlights" role="list">
                          {project.highlights.map(highlight => (
                            <li>{highlight}</li>
                          ))}
                        </ul>
                      </li>
                    ))}
                  </ul>
                )}

                {exp.additional && exp.additional.length > 0 && (
                  <ul class="exp-additional" role="list">
                    {exp.additional.map(item => (
                      <li>{item}</li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section" aria-labelledby="projects-heading">
      <h2 class="section-heading" id="projects-heading">Projects</h2>

      <ul class="projects-list" role="list">
        {
          PROJECTS.map(project => (
            <li>
              <article class="project-card">
                <h3 class="project-name">
                  <a
                    class="project-link"
                    href={project.url}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {project.name}
                    <span class="sr-only"> (opens in new tab)</span>
                  </a>
                </h3>

                <p class="project-description">{project.description}</p>

                {project.tags.length > 0 && (
                  <ul class="project-tags" role="list">
                    {project.tags.map(tag => (
                      <li class="project-tag">{tag}</li>
                    ))}
                  </ul>
                )}
              </article>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  /* -------------------------
   * Theme — Local Variables
   * ------------------------- */
  :root {
    --about-padding-y: 8rem;
    --about-content-width: 44rem;
    --about-section-gap: 6rem;
  }

  /* -------------------------
   * Layout — Page Container
   * ------------------------- */
  .container {
    display: flex;
    flex-direction: column;
    gap: var(--about-section-gap);
    margin-inline: auto;
    padding-block: var(--about-padding-y);
    max-width: var(--about-content-width);
  }

  /* -------------------------
   * Module — Bio
   * Name heading, paragraphs, and social links
   * ------------------------- */
  .name {
    margin-block-end: 2rem;
    font-weight: 700;
    font-size: 2.5rem;
    line-height: 1.2;
    font-family: var(--font-display);
    font-optical-sizing: auto;
  }

  .bio {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-block-end: 2.5rem;
    color: var(--color-surface-700);
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  /* -------------------------
   * Module — Section Heading
   * Small-caps label for Experience / Projects sections
   * ------------------------- */
  .section-heading {
    margin-block-end: 1.5rem;
    color: var(--color-surface-600);
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: var(--letter-spacing-caps);
    text-transform: uppercase;
  }

  /* -------------------------
   * Module — Experience List
   * Icon badge + company / role / period layout
   * ------------------------- */
  .experience-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .experience-item {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
  }

  /* Icon badge — shows SVG icon or company initial */
  .exp-icon {
    display: flex;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background: var(--color-surface-100);
    width: 2.5rem;
    height: 2.5rem;
    overflow: hidden;
  }

  .exp-icon :global(svg) {
    width: 2.5rem;
    height: 2.5rem;
  }

  .exp-initial {
    color: var(--color-surface-600);
    font-weight: 700;
    font-size: 1rem;
    font-family: var(--font-display);
    user-select: none;
    text-transform: uppercase;
  }

  .exp-content {
    flex: 1;
    min-width: 0;
  }

  .exp-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-block-end: 0.25rem;
  }

  .exp-company {
    font-weight: 700;
    font-size: 1.0625rem;
    line-height: 1.4;
  }

  .exp-period {
    flex-shrink: 0;
    color: var(--color-surface-500);
    font-size: 0.875rem;
    white-space: nowrap;
  }

  .exp-role {
    margin-block-end: 0.75rem;
    color: var(--color-surface-600);
    font-size: 0.875rem;
  }

  .exp-projects {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 0;
  }

  .exp-project {
    padding-inline-start: 0;
  }

  .exp-project-name {
    color: var(--color-surface-700);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .exp-highlights {
    margin-block-start: 0.25rem;
    padding-inline-start: 1.125rem;
    color: var(--color-surface-600);
    font-size: 0.875rem;
    line-height: 1.4;
    list-style: disc;
  }

  .exp-additional {
    margin-block-start: 0.5rem;
    padding-inline-start: 1.125rem;
    color: var(--color-surface-600);
    font-size: 0.875rem;
    line-height: 1.6;
    list-style: disc;
  }

  /* -------------------------
   * Module — Projects List
   * Bordered cards with title link, description, and tech tags
   * ------------------------- */
  .projects-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .project-card {
    position: relative;
    transition: border-color var(--transition);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    padding: 1.25rem 1.5rem;
  }

  .project-name {
    margin-block-end: 1rem;
    font-weight: 700;
    font-size: 1.25rem;
    line-height: 1.4;
    font-family: var(--font-display);
    font-optical-sizing: auto;
  }

  .project-link {
    color: var(--color-text);
    text-decoration: none;
  }

  .project-link::after {
    position: absolute;
    z-index: 1;
    inset: 0;
    content: "";
  }

  .project-description {
    margin-block-end: 2.25rem;
    color: var(--color-surface-700);
    font-size: 1.0625rem;
    line-height: 1.53;
  }

  /* Tech tag pills */
  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .project-tag {
    border-radius: 9999px;
    background: var(--color-surface-100);
    padding: 0.4rem 0.8rem;
    color: var(--color-surface-700);
    font-size: 0.875rem;
    line-height: 1;
  }

  /* -------------------------
   * State — Interactive
   * ------------------------- */
  .project-card:hover {
    border-color: var(--color-border-hover);
  }

  .project-card:focus-within {
    outline: var(--focus-outline);
    outline-offset: var(--focus-offset);
    border-radius: 0.75rem;
  }

  .project-link:focus {
    outline: none;
  }

  /* -------------------------
   * State — Responsive
   * ------------------------- */
  @media (max-width: 64rem) {
    .container {
      padding-inline: 1.5rem;
    }
  }

  @media (max-width: 48rem) {
    :root {
      --about-padding-y: 5rem;
    }

    .exp-icon {
      display: none;
    }

    .exp-header {
      flex-wrap: wrap;
    }
  }

  @media (max-width: 40rem) {
    .name {
      font-size: 2rem;
    }
  }
</style>
